{
  "functions": {
    "api/data.js": {
      "includeFiles": "data/store.json"
    },
    "api/store.js": {
      "includeFiles": "data/store.json"
    },
    "api/orders.js": {
      "includeFiles": "data/store.json"
    }
  },
  "rewrites": [
    { "source": "/((?!api/|admin|img/|css/|js/|favicon\\.ico).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/orders-purge", "schedule": "0 8 * * *" }
  ]
}
